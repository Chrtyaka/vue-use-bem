{
  "name": "vue-use-bem",
  "version": "2.0.0",
  "author": "Slava Cherkesov",
  "license": "MIT",
  "type": "module",
  "description": "A simple utility for generate BEM classes",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "build": "rollup -c",
    "test": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "typecheck": "tsc --noEmit",
    "check": "publint && attw --pack ."
  },
  "homepage": "https://github.com/Chrtyaka/vue-use-bem#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chrtyaka/vue-use-bem"
  },
  "keywords": [
    "vue",
    "bem"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "provenance": true
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "21.0.4",
    "lefthook": "2.1.5",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "publint": "^0.3.25",
    "rollup": "4.60.1",
    "rollup-plugin-dts": "^6.5.1",
    "semantic-release": "25.0.3",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitepress": "1.6.3",
    "vitest": "3.2.4",
    "vue": "3.5.32"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  }
}
